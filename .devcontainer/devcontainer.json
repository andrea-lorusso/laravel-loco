{
  "name": "Laravel Lo. Co.",
  "dockerComposeFile": "../docker-compose-local.yml",
  "initializeCommand": "bash .devcontainer/bootstrap.sh",
  "service": "laravel_loco_nginx",
  "workspaceFolder": "/var/www",
  "mounts": [
    "source=${localEnv:HOME}/.ssh/config,target=/root/.ssh/config,type=bind,readonly",
  ],
  "forwardPorts": [
    3306,
    80,
    5173,
    6379
  ],
  "portsAttributes": {
    "80": {
      "label": "Nginx",
      "onAutoForward": "notify"
    },
    "3306": {
      "label": "MySQL",
      "onAutoForward": "silent"
    },
    "6379": {
      "label": "Redis",
      "onAutoForward": "silent"
    },
    "5173": {
      "label": "Vite HMR",
      "onAutoForward": "notify"
    }
  },
  /*"postCreateCommand": "composer install && php artisan key:generate --force && php artisan migrate --force && yarn",*/
  "customizations": {
    "vscode": {
      "settings": {
        "php.validate.executablePath": "/usr/local/bin/php",
        "php.format.codeStyle": "PSR-2",
        "editor.formatOnSave": true,
        "editor.rulers": [120],
        "editor.trimAutoWhitespace": true,
        "editor.insertSpaces": true,
        "editor.tabSize": 4,
        "files.encoding": "utf8",
        "files.eol": "\n",
        "[php]": {
            "files.insertFinalNewline": true,
            "files.trimTrailingWhitespace": true
        },
        "[html]": {
            "editor.tabSize": 2
        },
        "[css]": {
            "editor.tabSize": 2
        },
        "[javascript]": {
            "editor.tabSize": 2
        },
        "[typescript]": {
            "editor.tabSize": 2
        },
        "[javascriptreact]": {
            "editor.tabSize": 2
        },
        "[typescriptreact]": {
            "editor.tabSize": 2
        },
        "[yaml]": {
            "editor.tabSize": 2
        },
        "[json]": {
            "editor.tabSize": 2
        },
        "[markdown]": {
            "editor.trimAutoWhitespace": false
        },
        "phpunit.phpunit": "/var/www/tests/vendor/bin/phpunit",
        "phpunit.args": ["-c", "/var/www/tests/phpunit.xml"]
      }
    }
  }
}
