#!/bin/bash

###############################################################################
# Conventional Commits validation
# Admitted types: feat, fix, refactor, perf, style, test, docs, build, ops, chore
# Breaking change: any type with ! (e.g., feat!:, fix(api)!:)
###############################################################################

COMMIT_MSG_FILE="$1"
COMMIT_MSG=$(cat "$COMMIT_MSG_FILE")

# Skip merge commits
if git rev-parse -q --verify MERGE_HEAD > /dev/null 2>&1; then
    exit 0
fi

# Skip merge commit messages generated by Git
if echo "$COMMIT_MSG" | grep -qE "^Merge (branch|pull request|remote-tracking branch)"; then
    exit 0
fi

PATTERN="^(feat|fix|refactor|perf|style|test|docs|build|ops|chore)(\(.+\))?!?: .+"

if ! echo "$COMMIT_MSG" | grep -qE "$PATTERN"; then
    echo ""
    echo "  Commit aborted: the message does not follow the Conventional Commits format."
    echo ""
    echo "  Expected format:  <type>[(<scope>)][!]: <description>"
    echo "  Admitted types:    feat | fix | refactor | perf | style | test | docs | build | ops | chore"
    echo "  Breaking change: add ! before the colon (e.g., feat!: or feat(api)!:)"
    echo ""
    echo "  Valid examples:"
    echo "    feat: add email validation in customer form"
    echo "    fix: correct calculation of remaining amount with VAT"
    echo "    chore: update composer dependencies"
    echo "    docs: update API documentation for practices"
    echo "    refactor: extract Service_RataService from MonitoringController"
    echo "    perf: optimize query for practice list with composite index"
    echo "    feat(api)!: remove deprecated endpoint /api/v1/lead"
    echo "    fix!: modify signature of calcolaImporto()"
    echo ""
    echo "  Received message: \"$COMMIT_MSG\""
    echo ""
    exit 1
fi

exit 0